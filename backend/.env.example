# Option A: single DSN (recommended)
# DATABASE_URL=mysql+pymysql://hanyu_app:CHANGE_ME_PASSWORD@127.0.0.1:3306/sales_warning_v1?charset=utf8mb4

# Option B: split fields (used when DATABASE_URL is empty)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hanyu_app
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_NAME=sales_warning_v1

# Optional pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Optional runtime directories (helpful for cloud deployment)
# STORAGE_DIR=/srv/hanyu-app/shared/uploads
# BACKUP_ROOT_DIR=/srv/hanyu-app/shared/backups
# LOG_ROOT_DIR=/srv/hanyu-app/shared/logs
